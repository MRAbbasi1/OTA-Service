# Local development only. Copy to .env and replace values for your environment.
ENVIRONMENT=development
APP_NAME=OTA-Service
APP_VERSION=0.1.0
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=change-me
DATABASE_URL=postgresql+psycopg://change-me:change-me@localhost:5432/change-me
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=change-me
MINIO_REGION=us-east-1
MINIO_SECURE=false

# OTA public base URLs (see docs/16-update-path-and-publication.md). In
# production these are https://api.ota-service.example and https://cdn.ota-service.example.
OTA_MANIFEST_BASE_URL=http://localhost:8080
OTA_FIRMWARE_BASE_URL=http://localhost:8080

# Administrative sessions (docs/08-security.md §§6-7).
# In production ADMIN_JWT_SECRET is required, must be a random value of at least
# 32 characters, and must not be this development default; the application
# refuses to start otherwise. Rotating it ends every live admin session.
ADMIN_JWT_SECRET=development-only-secret-do-not-use-in-production
ADMIN_ACCESS_TOKEN_TTL_MINUTES=30
# Unset means: Secure cookies in production, plain cookies in development (where
# the API is served over http). Production rejects an explicit false.
# ADMIN_COOKIE_SECURE=

# One-time bootstrap credentials for `uv run ota-admin`. Remove both from the
# deployment's secrets as soon as the first administrator exists.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
