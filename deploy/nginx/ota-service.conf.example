# Host-Nginx virtual host template for a shared server.
#
# This project claims three public hostnames, each with a single role:
#
#   api.<your-domain>   device manifest endpoint + health probes
#   cdn.<your-domain>   firmware binary delivery + health probes
#   ota.<your-domain>   administrative API + frontend SPA + health probes
#
# The existing host Nginx remains the sole owner of ports 80 and 443.
# Replace the example hostnames and the certificate directory before enabling.
#
# TLS listeners use `listen 443 ssl http2;`, which works on every nginx
# version. On nginx >= 1.25.1 this form is deprecated but accepted; the
# modern equivalent is `listen 443 ssl;` plus a separate `http2 on;`.

upstream ota_service_api {
    server 127.0.0.1:18080;
    keepalive 32;
}

# ---------------------------------------------------------------------------
# api.<your-domain> — device manifest only
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name api.ota-service.example;

    ssl_certificate     /etc/letsencrypt/live/ota-service/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ota-service/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:ota_service_tls:10m;
    ssl_session_tickets off;

    client_max_body_size 1m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;

    location /api/v1/firmware/ {
        proxy_pass http://ota_service_api;
    }

    location = /health/live  { proxy_pass http://ota_service_api; }
    location = /health/ready { proxy_pass http://ota_service_api; }

    # No other route exists on this hostname.
    location / {
        return 404;
    }
}

# ---------------------------------------------------------------------------
# cdn.<your-domain> — firmware binary delivery only
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name cdn.ota-service.example;

    ssl_certificate     /etc/letsencrypt/live/ota-service/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ota-service/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:ota_service_tls:10m;
    ssl_session_tickets off;

    client_max_body_size 1m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;

    location /firmware/ {
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        proxy_pass http://ota_service_api;
    }

    location = /health/live  { proxy_pass http://ota_service_api; }
    location = /health/ready { proxy_pass http://ota_service_api; }

    location / {
        return 404;
    }
}

# ---------------------------------------------------------------------------
# ota.<your-domain> — administrative API + frontend SPA
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name ota.ota-service.example;

    ssl_certificate     /etc/letsencrypt/live/ota-service/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ota-service/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:ota_service_tls:10m;
    ssl_session_tickets off;

    # Administrative firmware uploads go through this hostname.
    client_max_body_size 64m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;

    location /api/v1/admin/ {
        proxy_cache off;
        proxy_pass http://ota_service_api;
    }

    # Device paths and unknown API paths are never served on this hostname;
    # they must not fall through to the SPA.
    location /api/ { return 404; }
    location /firmware/ { return 404; }

    location = /health/live  { proxy_pass http://ota_service_api; }
    location = /health/ready { proxy_pass http://ota_service_api; }

    # Frontend SPA — served as static files by the host.
    # The exact document root is a deployment value; adjust before enabling.
    # `=404` keeps a missing document root a clean 404 instead of a try_files
    # internal redirection cycle (which nginx reports as 500).
    location / {
        root /var/www/ota-dashboard;
        index index.html;
        try_files $uri $uri/ /index.html =404;
    }
}

# ---------------------------------------------------------------------------
# HTTP → HTTPS redirect for all three hostnames
# ---------------------------------------------------------------------------
server {
    listen 80;
    server_name api.ota-service.example cdn.ota-service.example ota.ota-service.example;
    return 301 https://$host$request_uri;
}