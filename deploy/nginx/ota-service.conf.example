# Host-Nginx virtual host template for a shared server.
#
# This project claims three public hostnames, each with a single role:
#
#   api.<your-domain>   device manifest endpoint + health probe
#   cdn.<your-domain>   firmware binary delivery + health probe
#   ota.<your-domain>   administrative API + frontend SPA + health probe
#
# The existing host Nginx owns ports 80 and 443. HTTP requests redirect to
# HTTPS; device OTA URLs must already use HTTPS because firmware clients do
# not follow redirects.
# Replace all hostname and certificate-directory placeholders before enabling.
# Replace every <your-dashboard-path> with the exact DASHBOARD_PATH used by
# the dashboard production build. Use one segment without surrounding slashes.
# GitHub secrets and backend .env values are not expanded by host Nginx.
#
# TLS listeners retain the supplied host's `listen 443 ssl http2;` syntax.
# On nginx >= 1.25.1 this form is deprecated but accepted; the
# modern equivalent is `listen 443 ssl;` plus a separate `http2 on;`.

# Included from Nginx's http context. Never log raw URI/query, credentials,
# cookies, IP addresses or user-agent strings for device traffic.
map $http_x_device_serial $ota_claimed_serial {
    default "";
    "~^[0-9]{1,19}$" $http_x_device_serial;
}
map $uri $ota_route_class {
    default unmatched;
    ~^/api/v1/firmware/ manifest;
    ~^/firmware/ firmware;
    /health health;
}
log_format ota_device_safe escape=json
    '{"at":"$time_iso8601","edge_id":"$request_id",'
    '"request_id":"$upstream_http_x_request_id","route":"$ota_route_class",'
    '"claimed_serial":"$ota_claimed_serial","status":$status,'
    '"upstream_status":"$upstream_status","duration_seconds":$request_time}';

upstream ota_service_api {
    server 127.0.0.1:18080;
    keepalive 32;
}
# ---------------------------------------------------------------------------
# api.<your-domain> — device manifest only
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name <your-api-host>;
    access_log /var/log/nginx/ota-device-access.log ota_device_safe;

    ssl_certificate     /etc/letsencrypt/live/<your-domain>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<your-domain>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ota_tls:10m;
    ssl_session_tickets off;

    client_max_body_size 1m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_read_timeout 900s;

    # Device manifest endpoint only.
    location /api/v1/firmware/ {
        # Supply a trusted edge correlation ID; the API canonicalizes this UUID.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_set_header X-Request-ID $request_id;
        proxy_pass http://ota_service_api;
    }

    # Public reachability probe. The role marker tells the API which
    # dependencies to check: for the manifest host that is the database only.
    # The detailed probes (/health/live, /health/ready, /health/detail) are
    # loopback-only and are deliberately not proxied here.
    location = /health {
        proxy_pass http://ota_service_api/health;
        proxy_set_header X-OTA-Role "api";
    }
    location /health/ { return 404; }

    # Everything else → 404.
    location / {
        return 404;
    }
}

# ---------------------------------------------------------------------------
# cdn.<your-domain> — firmware binary only
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name <your-cdn-host>;
    access_log /var/log/nginx/ota-device-access.log ota_device_safe;

    ssl_certificate     /etc/letsencrypt/live/<your-domain>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<your-domain>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ota_tls:10m;
    ssl_session_tickets off;

    client_max_body_size 1m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_read_timeout 900s;

    # Firmware binary endpoint only, no buffering. The device requires an
    # exact Content-Length and does not support chunked transfer encoding, so
    # Nginx must not buffer, re-frame, or compress the response body.
    location /firmware/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_set_header X-Request-ID $request_id;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        proxy_pass http://ota_service_api;
    }

    # Public reachability probe. For the delivery host the check is object
    # storage: a database outage does not stop this hostname serving firmware.
    location = /health {
        proxy_pass http://ota_service_api/health;
        proxy_set_header X-OTA-Role "cdn";
    }
    location /health/ { return 404; }

    location / {
        return 404;
    }
}

# ---------------------------------------------------------------------------
# ota.<your-domain> — administrative API + frontend SPA
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name <your-admin-host>;

    ssl_certificate     /etc/letsencrypt/live/<your-domain>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<your-domain>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ota_tls:10m;
    ssl_session_tickets off;

    # Administrative firmware uploads go through this hostname.
    client_max_body_size 64m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_read_timeout 900s;

    # Admin API. Its longer prefix wins over `location /api/` below for
    # /api/v1/admin/*; every other /api/ path is rejected by that location.
    location /api/v1/admin/ {
        proxy_pass http://ota_service_api;
    }

    # Public reachability probe checks database and object storage. The
    # dashboard HTML is checked separately at the configured prefix.
    location = /health {
        proxy_pass http://ota_service_api/health;
        proxy_set_header X-OTA-Role "ota";
    }
    location /health/ { return 404; }

    # Device paths are not served on this hostname. The API prefix is exact
    # and never collides with an SPA route; the firmware path shape is
    # matched by a regex. Dashboard firmware pages use the configured prefix.
    location /api/ { return 404; }
    location ~ ^/firmware/[^/]+/[^/]+/v[^/]+/[^/]+$ {
        return 404;
    }

    # Replace <your-dashboard-path> with the DASHBOARD_PATH used for the build.
    # Only the configured prefix serves HTML and assets. The rewrite strips it
    # internally; it does not redirect or expose a root-level static location.
    location ^~ /<your-dashboard-path>/assets/ {
        rewrite ^/<your-dashboard-path>/(.*)$ /$1 break;
        root /var/www/ota-dashboard;
        try_files $uri =404;
    }
    location ^~ /<your-dashboard-path>/ {
        rewrite ^/<your-dashboard-path>/(.*)$ /$1 break;
        root /var/www/ota-dashboard;
        try_files $uri /index.html =404;
    }

    # Root, old SPA URLs, and incorrect prefixes return Nginx 404 responses.
    location / {
        return 404;
    }
}

# ---------------------------------------------------------------------------
# HTTP-to-HTTPS redirect retained from the supplied production configuration
# ---------------------------------------------------------------------------
server {
    listen 80;
    server_name <your-api-host> <your-cdn-host> <your-admin-host>;
    return 301 https://$host$request_uri;
}
