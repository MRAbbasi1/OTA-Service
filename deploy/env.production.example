# Production runtime environment (host only) — create ONCE at /opt/ota-service/.env
# chmod 600 ; chown ota-deploy:ota-deploy
# GitHub Actions starts postgres + minio + api from this file but never writes it.
#
# Generate secrets:
#   openssl rand -hex 24   # POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD
#   openssl rand -hex 32   # ADMIN_JWT_SECRET
# Use hex-only passwords so DATABASE_URL needs no URL-encoding.

ENVIRONMENT=production
APP_NAME=OTA-Service
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# PostgreSQL (compose service name: postgres)
POSTGRES_USER=ota
POSTGRES_PASSWORD=REPLACE_OPENSSL_RAND_HEX_24
POSTGRES_DB=ota
# Optional literal; compose also injects DATABASE_URL from the values above.
DATABASE_URL=postgresql+psycopg://ota:REPLACE_OPENSSL_RAND_HEX_24@postgres:5432/ota
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30

# MinIO (compose service name: minio). Production requires TLS.
MINIO_ROOT_USER=ota-minio
MINIO_ROOT_PASSWORD=REPLACE_OPENSSL_RAND_HEX_24
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ota-minio
MINIO_SECRET_KEY=REPLACE_OPENSSL_RAND_HEX_24
MINIO_BUCKET=ota-firmware
MINIO_REGION=us-east-1
MINIO_SECURE=true
MINIO_CA_CERT=/etc/ota/certs/ota-minio-ca.crt

# Public HTTPS hostnames (must match Nginx + device OTA_ONLINE_URL).
OTA_MANIFEST_BASE_URL=https://api.REPLACE_DOMAIN
OTA_FIRMWARE_BASE_URL=https://cdn.REPLACE_DOMAIN

ADMIN_JWT_SECRET=REPLACE_OPENSSL_RAND_HEX_32
ADMIN_ACCESS_TOKEN_TTL_MINUTES=30

# One-time only. Remove both after the first administrator exists.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
